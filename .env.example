############################
# Base application settings
############################

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BACKEND_URL=redis://localhost:6379/1

MONGODB_URL=mongodb://user:password@localhost:27017/app_db

LOG_LEVEL=DEBUG

LOG_TG_LEVEL=INFO
LOG_TG_TOKEN=123456789:telegram-bot-token
LOG_TG_CHAT=-1001234567890

# Comma-separated lists
NOTIFIERS=KAFKA,TELEGRAM,TELEGRAM_VERBOSE
SCRAPERS=HABR,HH


############################
